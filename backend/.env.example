DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Add your computer's local IPv4 address above when testing on a physical phone.
FCM_ENABLED=false
# Optional: path to YOUR Firebase service account, never put this inside the app.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/cropcare-firebase-admin.json
TF_CPP_MIN_LOG_LEVEL=2
